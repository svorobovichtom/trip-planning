# Site block for the trip app. Installed as /etc/caddy/sites.d/trip.caddy by
# deploy/setup.sh, which replaces __DOMAIN__.
__DOMAIN__ {
	request_body {
		max_size 20MB
	}
	# Admin UI and superuser login only via SSH tunnel, never from the internet.
	@admin path /_ /_/* /api/collections/_superusers/*
	respond @admin 404
	reverse_proxy 127.0.0.1:8090
}
